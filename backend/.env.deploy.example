# 複製成 .env.deploy 再填值。**.env.deploy 已被 .gitignore 擋住，不要進 git。**
#
#     source .env.deploy && python deploy_lambdas.py
#
# ⚠️ 為什麼這些值不寫進文件裡：
#    API Gateway 目前**沒有認證**，網址等於憑證——知道網址就能建案件、
#    跑階段、讀卷證，還會燒掉 Bedrock 額度。repo 現在是 private，
#    但比賽後常會轉公開，所以一開始就不要寫進版控。
#
# 值從哪裡拿：
#    AWS_DEFAULT_REGION  你建資源的區域
#    OS_ENDPOINT         provision_aoss.py 執行完會印，或 AOSS Console
#    API_BASE            provision_apigw.py 執行完會印，或 API Gateway Console
#    APPEAL_BUCKET       你的 S3 桶名

export AWS_DEFAULT_REGION=us-east-1
export APPEAL_BUCKET=
export OS_ENDPOINT=
export API_BASE=

# 模型 ID（不填就用 deploy_lambdas.py 裡的預設）
# export MODEL_MAIN=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# export MODEL_CHEAP=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ⚠️ 比賽規定 Bedrock ≤ 1 RPS。**不要改這個值**，除非比賽結束。
# export BEDROCK_MAX_RPS=1
